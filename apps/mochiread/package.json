{
  "name": "mochiread",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dict": "node scripts/build-dict.mjs",
    "build:decomp": "node scripts/build-decomp.mjs",
    "build:data": "pnpm run build:dict && pnpm run build:decomp",
    "eas:login": "eas login",
    "eas:whoami": "eas whoami",
    "eas:setup": "eas init --non-interactive --force && eas update:configure --non-interactive --platform all",
    "publish": "eas update --branch production --message \"$(git log -1 --pretty=%s 2>/dev/null || echo 'manual publish')\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@jamsch/react-native-hanzi-writer": "^1.2.0",
    "@mochilang/dict": "workspace:*",
    "@mochilang/srs": "workspace:*",
    "@mochilang/translate": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "pinyin-pro": "^3.28.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
