            }
          ]
        },
        {
          "id": "zh-en-compare-3",
          "title": "The most (最)",
          "description": "Superlatives without 比",
          "theme": "basics",
          "xp": 14,
          "exercises": [
            {
              "id": "cm3-1",
              "type": "multiple_choice",
              "prompt": "What does \"最\" (zuì) mean?",
              "options": ["More", "The most", "Less", "Equal"],
              "answer": "The most"
            },
            {
              "id": "cm3-2",
              "type": "tap_words_in_order",
              "prompt": "Build \"I like tea the most\"",
              "answer": "我 最 喜欢 茶",
              "bank": ["我", "最", "喜欢", "茶", "比", "更"]
            },
            {
              "id": "cm3-3",
              "type": "multiple_choice",
              "prompt": "What does \"她 最 高\" mean?",
              "options": ["She is taller", "She is the tallest", "She is not tall", "She is shorter"],
              "answer": "She is the tallest"
            }
          ]
        },
        {
