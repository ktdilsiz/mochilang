# Copy this to apps/web/.env.local and fill in the values from your
# Google Cloud Console OAuth client.
#
# Vite only exposes env vars prefixed with VITE_ to the client bundle, so
# anything else here is silently ignored at build time.

# OAuth 2.0 Client ID (Web application). Same value as the backend's
# MOCHILANG_GOOGLE_CLIENT_ID — the frontend uses it as `client_id` for the
# Sign-in with Google button, the backend uses it as the audience claim
# during ID-token verification.
VITE_GOOGLE_CLIENT_ID=

# Override the API base URL if you're not running on the default port.
# VITE_API_BASE_URL=http://localhost:8181
