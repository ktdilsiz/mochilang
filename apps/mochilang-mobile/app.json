{
  "expo": {
    "name": "Mochilang",
    "slug": "mochilang-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fffbf2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mochilang.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fffbf2"
      },
      "package": "com.mochilang.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "blockedPermissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "_comment": "apiUrl is unused in the offline-only release — setOfflineMode(true) short-circuits every request. Kept as an HTTPS placeholder so Play review can't flag a clear-text localhost reference. Override in eas.json env or app.config.js once a hosted API is wired up.",
      "apiUrl": "https://api.mochilang.invalid",
      "eas": {
        "projectId": "ebfb910e-0d60-41f2-901c-65f85df23fc6"
      }
    },
    "owner": "ktdilsiz",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ebfb910e-0d60-41f2-901c-65f85df23fc6"
    }
  }
}
